<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StarOverlay.BuffTracker</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StarOverlay.Framework\StarOverlay.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\library\**\*.png" Link="assets\library\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- the names of the pictures the game has (not bundled): the picture picker lists them with the bundled ones -->
    <Content Include="assets\library\**\_game.txt" Link="assets\library\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
